<?xml version="1.0" encoding="utf-8"?>
<!-- Chagok panel only. Pleos draws the navigation, status bar and dock around this window. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FDFDFB" android:paddingHorizontal="20dp" tools:context=".ui.CarActivity" tools:theme="@style/Theme.Chagok">
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
        <TextView style="@style/Text.Title" android:layout_width="0dp" android:layout_weight="1" android:text="@string/app_name" android:textSize="20sp" />
        <TextView android:id="@+id/vehicle_destination" style="@style/Text.Body" android:layout_width="wrap_content" android:textSize="12sp" android:text="@string/vehicle_destination" />
    </LinearLayout>
    <ScrollView android:id="@+id/vehicle_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/vehicle_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical"><include layout="@layout/panel_radio" /></LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center">
        <Button android:id="@+id/vehicle_schedule" style="@style/Button.Nav" android:layout_height="48dp" android:text="@string/vehicle_schedule" />
        <Button android:id="@+id/vehicle_discover" style="@style/Button.Nav" android:layout_height="48dp" android:text="@string/vehicle_discover" />
        <Button android:id="@+id/vehicle_record" style="@style/Button.Nav" android:layout_height="48dp" android:text="@string/vehicle_record" />
    </LinearLayout>
</LinearLayout>
