<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_chagok"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chagok">
        <!-- Parked prototype: no distraction-optimized declaration or vehicle permissions. -->
        <activity android:name=".ui.CarActivity" android:exported="true" android:launchMode="singleTop"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
